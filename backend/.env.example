# ResumeCraft Backend Configuration
PORT=5000
NODE_ENV=development

# Free MongoDB Atlas URI (leave empty for zero-setup local file storage)
# Example: mongodb+srv://<username>:<password>@cluster0.mongodb.net/resumecraft?retryWrites=true&w=majority
MONGODB_URI=

# JWT Authentication Secret
JWT_SECRET=replace_with_a_secure_jwt_secret
JWT_EXPIRES_IN=7d

# Frontend URL
FRONTEND_URL=http://localhost:5173

# Optional: Google Gemini API Key for AI resume enhancements
GEMINI_API_KEY=
